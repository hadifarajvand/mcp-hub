# Dokploy Connection Configuration
# The Dokploy API endpoint and credentials for the MCP server to communicate with Dokploy

# Dokploy API URL (this MCP will connect to Dokploy's API)
# When running with Dokploy, use the internal URL or the public domain
# Examples:
#   - Local: http://dokploy:3000 or http://localhost:3000
#   - Remote: https://deploy.yourdomain.com
DOKPLOY_URL=http://dokploy:3000

# Dokploy API Key
# Generate this from: Dokploy Dashboard -> Settings -> API Tokens
# This key grants access to manage deployments, databases, etc.
DOKPLOY_API_KEY=your-api-key-here

# Optional: Bearer token for the MCP endpoint itself
# This adds an additional layer of security to the HTTP MCP endpoint
# Format: pass Authorization: Bearer <token> header to access MCP tools
# Leave empty to allow unauthenticated access within the network
MCP_BEARER_TOKEN=

# HTTP Server Configuration
MCP_HTTP_PORT=8000
MCP_HOST=0.0.0.0

# Advanced: Rate limiting for MCP calls (requests per minute)
# Default: 60
MCP_RATE_LIMIT=60

# Advanced: Timeout for Dokploy API calls (in seconds)
# Default: 30
DOKPLOY_TIMEOUT=30
