FROM python:3.11-slim

WORKDIR /app

# Minimal dependencies - skip network-dependent installs for testing
RUN apt-get update -qq && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/* || true

# Copy requirements and code
COPY requirements.txt .
COPY server.py .

# Install Python deps
RUN pip install --no-cache-dir fastapi uvicorn pydantic 2>/dev/null || pip install --no-cache-dir fastapi uvicorn pydantic

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "server.py"]
