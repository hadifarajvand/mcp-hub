# Transcriber MCP — OpenAI Whisper Configuration
# No credentials needed! Uses OpenAI Whisper for local speech recognition.

# Whisper Model Size
# Options: tiny (39M, fastest), base (140M), small (466M), medium (1.5G), large (2.9G, best quality)
# Default: base (good balance of speed/quality, pre-cached in container)
WHISPER_MODEL=base

# Whisper Models Directory (auto-cached)
# First run downloads model (~140MB for base), then cached locally
WHISPER_MODELS_DIR=/app/whisper_models

# HTTP Server Configuration
MCP_HTTP_PORT=8000
MCP_HOST=0.0.0.0

# Notes:
# - First transcription will take longer as Whisper processes the audio
# - GPU (CUDA) recommended for faster transcription (container includes PyTorch CUDA support)
# - Supports 99+ languages (en, pt-BR, es, fr, de, ja, zh, ar, etc.)
# - Formats: MP3, WAV, FLAC, OGG, M4A, MP4, MKV, WebM, and more
