# Transcriber MCP — Google's Built-in Speech Recognition Configuration
# Uses pyTranscriber with Google's speech recognition (via Autosub)
# No explicit credentials needed — uses Google's services directly

# HTTP Server Configuration
MCP_HTTP_PORT=8000
MCP_HOST=0.0.0.0

# Notes:
# - Uses Google's built-in speech recognition (no API keys needed)
# - Supports 100+ languages (en, pt-BR, es, fr, de, ja, zh, ar, etc.)
# - Formats: MP3, WAV, FLAC, OGG, M4A, MP4, MKV, WebM, and more
# - Output: plain text or SRT subtitles with timecodes
