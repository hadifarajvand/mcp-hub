# Google Cloud Speech-to-Text Configuration
# Follow these steps to set up:
# 1. Create a Google Cloud project: https://console.cloud.google.com
# 2. Enable Speech-to-Text API: https://console.cloud.google.com/apis/library/speech.googleapis.com
# 3. Create a service account: https://console.cloud.google.com/iam-admin/serviceaccounts
# 4. Download the JSON key file
# 5. Mount the key file to /app/credentials.json in the container (see docker-compose.yml)
# 6. Set GOOGLE_APPLICATION_CREDENTIALS to point to it

GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# HTTP Server Configuration
MCP_HTTP_PORT=8000
MCP_HOST=0.0.0.0

# Optional: Cache directory for processed files (mounted as volume)
CACHE_DIR=/app/cache

# Optional: Maximum file size for transcription (in bytes, default: 1GB)
MAX_FILE_SIZE=1073741824

# Optional: Timeout for long transcription jobs (in seconds, default: 300)
TRANSCRIPTION_TIMEOUT=300
