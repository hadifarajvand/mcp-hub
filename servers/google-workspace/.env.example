# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# OAuth Redirect URI (must match configured URI in Google Cloud Console)
# When deployed behind Dokploy, use: https://mcp.yourdomain.com/google-workspace/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=https://mcp.local/google-workspace/oauth/callback

# Which Google Workspace services to enable (comma-separated)
# Available: drive, docs, sheets, slides, gmail, calendar, tasks, meet, contacts, admin
# Recommended for general use: docs,sheets,slides,drive,gmail,calendar
TOOL_TIER=docs,sheets,slides,drive,gmail,calendar

# HTTP Server Configuration
MCP_HTTP_PORT=8000
MCP_HOST=0.0.0.0

# Google Scopes (auto-configured based on TOOL_TIER, but can be overridden)
# Default scopes provide read/write access to selected services
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/docs,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/presentations,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar
