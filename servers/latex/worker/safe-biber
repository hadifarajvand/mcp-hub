#!/usr/bin/env python3
"""Run biber only if every bibliography data source in the .bcf is a plain relative path.

kpathsea's paranoid mode (openin_any=p) does not cover biber, which will happily read /etc/passwd or any
other file the worker uid can see if a document says \addbibresource{/etc/passwd}.
"""
import html
import os
import re
import sys

args = sys.argv[1:]
job, dirs = None, ["."]
for a in args:
    if a.startswith(("--input-directory=", "--output-directory=")):
        dirs.insert(0, a.split("=", 1)[1])
    elif not a.startswith("-"):
        job = a

bcf = None
if job:
    names = {job, os.path.basename(job)}
    names |= {n + ".bcf" for n in list(names) if not n.endswith(".bcf")}
    for d in dirs:
        for n in names:
            p = os.path.join(d, n)
            if os.path.isfile(p):
                bcf = p
                break
        if bcf:
            break

if bcf:
    with open(bcf, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    for m in re.finditer(r"<bcf:datasource\b[^>]*>(.*?)</bcf:datasource>", text, re.S):
        p = html.unescape(m.group(1)).strip()
        if not p or p.startswith(("/", "~", "\\", "-")) or ".." in p.replace("\\", "/").split("/") or "://" in p or "\x00" in p:
            print(f"SANDBOX: bibliography source not allowed: {p[:80]!r} (use a relative path inside the project)", file=sys.stderr, flush=True)
            sys.exit(2)

os.execv("/usr/bin/biber", ["biber"] + args)
