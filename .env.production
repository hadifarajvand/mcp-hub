# MCP Hub - Production Environment Configuration
# Copy this template and set values for your Dokploy deployment
# Do NOT commit actual credentials to git

# ============================================================================
# GOOGLE WORKSPACE MCP (Port 8001)
# ============================================================================

# Google OAuth 2.0 Credentials
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-string-here

# OAuth Redirect URI (must match configured URI in Google Cloud Console)
# Format: https://yourdomain.com/google-workspace/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=https://mcp.yourdomain.com/google-workspace/oauth/callback

# Which Google Workspace services to enable
# Available: drive,docs,sheets,slides,gmail,calendar,tasks,meet,contacts,admin
TOOL_TIER=docs,sheets,slides,drive,gmail,calendar

# HTTP Server Configuration
MCP_HTTP_PORT=8000
MCP_HOST=0.0.0.0

# ============================================================================
# TRANSCRIBER MCP (Port 8002)
# ============================================================================

# Whisper Model Size (auto-downloads on first run)
# Options: tiny (39MB), base (140MB), small (461MB), medium (1.5GB), large (2.9GB)
# Recommended: base (good balance of speed and accuracy)
WHISPER_MODEL=base

# Transcriber language (optional, auto-detected if not set)
# Examples: en, es, fr, de, pt-BR, ja, zh, ar, hi
TRANSCRIBER_LANGUAGE=

# ============================================================================
# DOKPLOY MCP (Port 8003)
# ============================================================================

# Dokploy API Connection
# Get API key from: Dokploy Dashboard → Settings → API Tokens
DOKPLOY_URL=http://dokploy:3000
DOKPLOY_API_KEY=your-dokploy-api-key-here

# Optional: Bearer token for additional MCP security
# If set, requests must include: Authorization: Bearer <token>
MCP_BEARER_TOKEN=

# Dokploy API timeout (seconds)
DOKPLOY_TIMEOUT=30

# MCP rate limiting (requests per minute)
MCP_RATE_LIMIT=60

# ============================================================================
# GENERAL MCP CONFIGURATION
# ============================================================================

# MCP HTTP Server Port (same for all services internally)
MCP_HTTP_PORT=8000
MCP_HOST=0.0.0.0

# Logging level
LOG_LEVEL=info

# ============================================================================
# DOCKER COMPOSE SERVICE CONFIGURATION
# ============================================================================

# These are typically auto-managed by docker-compose
# but can be overridden if needed

COMPOSE_PROJECT_NAME=mcp-hub
COMPOSE_FILE=docker-compose.yml

# Network configuration
NETWORK_NAME=mcp-hub-network

# Volume configuration
TOKENS_VOLUME=google-workspace-tokens

# ============================================================================
# DOKPLOY-SPECIFIC CONFIGURATION
# ============================================================================

# Health check configuration (set in docker-compose.yml)
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD_GOOGLE=60s
HEALTHCHECK_START_PERIOD_TRANSCRIBER=180s
HEALTHCHECK_START_PERIOD_DOKPLOY=45s

# Restart policy
RESTART_POLICY=unless-stopped

# ============================================================================
# OPTIONAL: SSL/TLS CONFIGURATION
# ============================================================================

# Note: Dokploy auto-configures TLS via Let's Encrypt
# These are only needed if using custom certificates

SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# ============================================================================
# PRODUCTION SECURITY NOTES
# ============================================================================

# 1. Never commit this file with real credentials to git
# 2. Use Dokploy's secrets management for production
# 3. Rotate API keys periodically
# 4. Enable MCP_BEARER_TOKEN for additional security layer
# 5. Use HTTPS only (Dokploy auto-enables)
# 6. Keep OAuth redirect URI in sync with deployment domain
# 7. Monitor logs for auth failures: docker logs mcp-*

# ============================================================================
# VERIFICATION CHECKLIST
# ============================================================================

# Before deploying, verify:
# [ ] GOOGLE_OAUTH_CLIENT_ID is set
# [ ] GOOGLE_OAUTH_CLIENT_SECRET is set
# [ ] GOOGLE_OAUTH_REDIRECT_URI matches your domain
# [ ] DOKPLOY_URL is reachable and correct
# [ ] DOKPLOY_API_KEY is valid
# [ ] WHISPER_MODEL is one of: tiny,base,small,medium,large
# [ ] MCP_HTTP_PORT is 8000 (standard for all MCPs)
# [ ] Firewall allows ports 8001-8003 (or Traefik proxy)
# [ ] DNS A record for mcp.yourdomain.com points to Dokploy server IP
# [ ] All credentials stored securely (not in git)

# ============================================================================
# DEPLOYMENT INSTRUCTIONS
# ============================================================================

# 1. Copy this file: cp .env.production .env.dokploy
# 2. Fill in all credentials
# 3. Add to Dokploy via environment variables (not file upload)
# 4. Click Deploy in Dokploy dashboard
# 5. Wait for all services to show Healthy
# 6. Test endpoints: curl https://mcp.yourdomain.com/*/health
# 7. Connect MCPs to Claude Desktop/Code
# 8. Test with sample Claude prompts

# For detailed instructions, see: DOKPLOY_DEPLOYMENT.md
