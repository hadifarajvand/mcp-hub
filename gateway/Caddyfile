# MCP Hub gateway: the only service exposed to the outside world.
#
# Every MCP route is protected by OAuth: Caddy asks hub-auth (forward_auth) to validate the bearer token,
# check that it was issued for THAT route (audience) and carries a scope for it. Only then is the request
# proxied, with the client's Authorization header removed and identity headers set by the gateway itself.
#
# To add an MCP: add one `import mcp_route <name> <service>:<port>` line below, add the route and its scopes in
# servers/hub-auth/hubauth/resources.py, and it is served at https://<domain>/<name>/mcp

{
	admin off
	auto_https off
	servers {
		# Dokploy's Traefik sits in front; trust it for X-Forwarded-*.
		trusted_proxies static private_ranges
	}
}

# Token check. NOTE: `copy_headers` only OVERWRITES a header when the auth response contains it; it does not remove a
# client-supplied copy (verified with tests/gateway_failclosed.py). So identity headers are stripped first, inside a
# `route` block so the order is guaranteed: nothing a client sends in X-Hub-* can survive to the upstream.
(authed) {
	route {
		request_header -X-Hub-Subject
		request_header -X-Hub-Client
		request_header -X-Hub-Scopes
		request_header -X-Hub-Readonly
		request_header -X-Hub-Route
		request_header -X-Hub-Client-IP
		forward_auth hub-auth:9000 {
			uri /verify
			header_up X-Hub-Route {args[0]}
			header_up X-Hub-Client-IP {client_ip}
			copy_headers X-Hub-Subject X-Hub-Client X-Hub-Scopes X-Hub-Readonly
		}
	}
}

(mcp_route) {
	handle_path /{args[0]}/* {
		import authed {args[0]}
		reverse_proxy {args[1]} {
			header_up -Authorization
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}
}

:8080 {
	log {
		output stdout
		format filter {
			wrap json
			# Never log query strings: clients sometimes put secrets in them.
			request>uri regexp \?.* ?REDACTED
			request>headers>Authorization replace REDACTED
			request>headers>Cookie replace REDACTED
		}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}

	request_body {
		max_size 64MB
	}

	route {
		respond /healthz "ok" 200

		# OAuth endpoints and discovery documents: public by definition. /verify is deliberately NOT here.
		@oauth path /.well-known/oauth-authorization-server /.well-known/oauth-protected-resource/* /authorize /token /register /revoke /consent
		handle @oauth {
			reverse_proxy hub-auth:9000 {
				header_up -X-Hub-Route
				header_up X-Hub-Client-IP {client_ip}
				flush_interval -1
			}
		}

		# Google redirects the user's browser here after consent; it cannot carry our bearer token.
		# The upstream validates the OAuth state itself.
		handle /google-workspace/oauth2callback {
			rewrite * /oauth2callback{query}
			reverse_proxy google-workspace:8000 {
				header_up -Authorization
			}
		}

		import mcp_route dokploy dokploy:3000
		import mcp_route transcriber transcriber:8000
		import mcp_route web web:8000
		import mcp_route latex latex:8000
		import mcp_route google-workspace google-workspace:8000

		# github-mcp-server's HTTP mode authenticates to GitHub with the bearer token it receives, so after our
		# OAuth check the gateway substitutes the PAT. Read/write follows the token's scope (hub-auth sets
		# X-Hub-Readonly); every other client-supplied X-MCP-* control header is dropped.
		handle_path /github/* {
			import authed github
			# Fail CLOSED: github-mcp-server treats a missing/empty X-MCP-Readonly as read-write (verified). Only an
			# explicit "0" from hub-auth (a token holding github:write) lifts read-only; anything else stays read-only.
			map {http.request.header.X-Hub-Readonly} {mcp_readonly} {
				"0" "false"
				default "true"
			}
			@github_off expression `"{$GITHUB_PERSONAL_ACCESS_TOKEN}" == ""`
			respond @github_off `{"error":"github MCP not configured: set GITHUB_PERSONAL_ACCESS_TOKEN"}` 503
			reverse_proxy github:8082 {
				header_up Host {upstream_hostport}
				header_up -X-MCP-Toolsets
				header_up -X-MCP-Tools
				header_up -X-MCP-Exclude-Tools
				header_up -X-MCP-Features
				header_up -X-MCP-Lockdown
				header_up -X-MCP-Insiders
				header_up X-MCP-Readonly {mcp_readonly}
				header_up Authorization "Bearer {$GITHUB_PERSONAL_ACCESS_TOKEN}"
				flush_interval -1
			}
		}

		respond `{"error":"not found"}` 404
	}
}
