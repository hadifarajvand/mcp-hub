# MCP Hub configuration. In Dokploy, paste these into the Compose app's
# "Environment" tab. Locally: cp .env.example .env and fill in.

# --- Required ------------------------------------------------------------
# Public origin of the hub, no trailing slash, https (used as the OAuth issuer and in redirects).
PUBLIC_BASE_URL=https://mcp.example.com

# OAuth owner login. Generate BOTH with:  ./scripts/gen-owner.sh   (nothing is stored)
# Whoever passes this login can authorize clients for Dokploy, GitHub and Google, so use a long unique password.
HUB_OWNER_PASSWORD_HASH=
HUB_OWNER_TOTP_SECRET=

# Optional: where authorization responses may be sent without an "unverified application" warning.
# Comma-separated; a trailing * matches a prefix. Defaults cover Claude and ChatGPT connectors.
# OAUTH_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://chatgpt.com/connector/oauth/*

# --- Dokploy MCP -----------------------------------------------------------
# Dokploy panel URL reachable from the container, e.g. http://dokploy:3000
# (same server) or https://dokploy.example.com
DOKPLOY_URL=
# Dokploy → Settings → Profile → API/CLI → Generate token
DOKPLOY_API_KEY=
# Tool groups: all | minimal | core | deploy | databases | git
DOKPLOY_TOOL_PRESET=deploy

# --- GitHub MCP ------------------------------------------------------------
# Fine-grained PAT scoped to the repositories the hub should see.
GITHUB_PERSONAL_ACCESS_TOKEN=
# 1 = read-only tools only (default). Set 0 to allow writes.
GITHUB_READ_ONLY=1
GITHUB_TOOLSETS=default

# --- Transcriber MCP (Google Cloud Speech-to-Text) --------------------------
# Full service-account JSON on one line, with Speech-to-Text API enabled.
GOOGLE_CREDENTIALS_JSON=
TRANSCRIBER_MAX_INPUT_MB=20

# --- Google Workspace MCP --------------------------------------------------
# OAuth client (type "Web application") with authorized redirect URI:
#   ${PUBLIC_BASE_URL}/google-workspace/oauth2callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The Google account the hub acts as (single-user mode).
USER_GOOGLE_EMAIL=
# core | extended | complete
WORKSPACE_TOOL_TIER=core
