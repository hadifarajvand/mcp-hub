# MCP Hub — Root Environment Template
# Copy per-service .env files from servers/*/.env.example
#
# This file documents the high-level setup.
# Actual configuration goes in each service's .env file:
#   - servers/google-workspace/.env
#   - servers/transcriber/.env
#   - servers/dokploy/.env

# ==============================================================================
# GOOGLE WORKSPACE MCP CONFIGURATION
# ==============================================================================
# See docs/oauth-setup.md for full instructions

# OAuth 2.0 Credentials from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# OAuth Redirect URI (must match Google Cloud Console settings)
# Local:  http://localhost:8001/oauth/callback
# Remote: https://mcp.yourdomain.com/google-workspace/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/oauth/callback

# Which Google services to enable (comma-separated)
TOOL_TIER=docs,sheets,slides,drive,gmail,calendar

# ==============================================================================
# TRANSCRIBER MCP CONFIGURATION
# ==============================================================================
# See docs/gcp-setup.md for full instructions

# Path to Google Cloud service account JSON credentials
# In Docker, this should point to a mounted volume location
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# ==============================================================================
# DOKPLOY MCP CONFIGURATION
# ==============================================================================
# See docs/deployment.md for full instructions

# Dokploy API endpoint (internal URL when both run in Docker)
DOKPLOY_URL=http://dokploy:3000

# Dokploy API Key (generate in Dokploy dashboard: Settings -> API Tokens)
DOKPLOY_API_KEY=your-dokploy-api-key

# Optional: Bearer token for MCP endpoint authentication
MCP_BEARER_TOKEN=

# ==============================================================================
# DEPLOYMENT INFORMATION
# ==============================================================================
# For local development, copy environment variables to each service:
#   cp servers/google-workspace/.env.example servers/google-workspace/.env
#   cp servers/transcriber/.env.example servers/transcriber/.env
#   cp servers/dokploy/.env.example servers/dokploy/.env
#
# Then edit each .env file with your actual credentials.
#
# For Dokploy deployment, set these as service environment variables in the UI
# (never commit .env files to Git).
